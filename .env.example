# Base URL of the Cloudflare Worker API (no trailing slash needed).
VITE_API_URL=http://localhost:8787

# Dev only: set to 1 to use the built-in mock API (sample result, no worker needed).
# Ignored by `npm run build` — the mock is never part of the production bundle.
# A PDF whose name contains "blad" makes the mock return an error.
VITE_MOCK_API=0
